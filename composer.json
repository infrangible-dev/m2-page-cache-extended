{
    "name": "infrangible/m2-page-cache-extended",
    "description": "Lets you keep separate full page cache versions depending on rules for URL parameters, headers, cookies or server values.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Performance",
        "full page cache variations",
        "cache by cookie or header",
        "vary full page cache"
    ],
    "homepage": "https://bitbucket.org/infrangible/m2-page-cache-extended",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\PageCacheExtended\\": "src"
        }
    }
}
